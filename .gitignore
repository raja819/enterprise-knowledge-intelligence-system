# Secrets and environment variables
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local vector database and generated logs
storage/*
!storage/.gitkeep
logs/*
!logs/.gitkeep
*.log

# Raw and processed data
data/raw/*
!data/raw/.gitkeep
!data/raw/sample_report.pdf
data/processed/*
!data/processed/.gitkeep

# Evaluation evidence
data/evaluation/*
!data/evaluation/.gitkeep
!data/evaluation/rag_test_cases.json
!data/evaluation/rag_evaluation_results.json
!data/evaluation/rag_evaluation_results.csv
!data/evaluation/rag_evaluation_results.json