# Application
APP_NAME=Enterprise Knowledge Intelligence System
APP_ENV=development
LOG_LEVEL=INFO

# LLM configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_documents

# Retrieval settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5